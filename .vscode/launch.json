    "version": "0.2.0",
    "configurations": [

        {
            "name": "Clang GDB Debug MsysUcrt",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-windows-debug/casttui.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/",
            "environment": [],
            "externalConsole": true, // gdb cannot handle pdcurses console context
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe", // default msys gdb install path
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
